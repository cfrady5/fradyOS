# --- Supabase (required) -----------------------------------------------------
# Project URL and publishable key from Supabase Dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Secret (service role) key. Server-only. Used by the scheduled sync and reminder jobs.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# --- App ---------------------------------------------------------------------
# Local design preview with demo data and no sign-in (ignored on Vercel): FRADYOS_PREVIEW=1
FRADYOS_PREVIEW=
# Public origin used in auth emails (magic links / confirmations). Optional locally.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Private workspace: sign-ups are closed unless this is "true". Create users in the Supabase dashboard instead.
ALLOW_SIGNUP=false
# Optional username alias for the sign-in form (type this instead of the email).
LOGIN_USERNAME=
LOGIN_EMAIL=

# --- Monday.com (optional; leave blank to keep the integration disconnected) --
# Personal API token from monday.com → Profile → Developers → My access tokens. Server-only.
MONDAY_API_TOKEN=
# Random string (16+ chars) that protects the inbound webhook URL: /api/webhooks/monday?token=<this>
MONDAY_WEBHOOK_SECRET=

# --- Plaid (optional; live bank balances and transactions) ------------------
# From dashboard.plaid.com → Developers → Keys. Server-only. CLIENT_ID / SECRET_Plaid are accepted as aliases.
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox (test banks: user_good / pass_good) or production (real banks; needs Production access in the Plaid dashboard).
PLAID_ENV=sandbox
# Products requested at Link time. Add "liabilities" for APR + minimum payments on cards and loans (extra Plaid cost).
PLAID_PRODUCTS=transactions
# Optional: register this exact URL under Plaid dashboard → Team Settings → API → Allowed redirect URIs (needed for OAuth banks such as Chase).
PLAID_REDIRECT_URI=
# 64 hex chars (openssl rand -hex 32). Encrypts stored access tokens. Falls back to a key derived from CRON_SECRET.
PLAID_TOKEN_ENCRYPTION_KEY=

# --- Scheduled jobs ----------------------------------------------------------
# Vercel sets Authorization: Bearer $CRON_SECRET on cron requests. Any long random string.
CRON_SECRET=change-me-to-a-long-random-string

# --- Email reminders (optional) ----------------------------------------------
# When set, the reminders job can email digests via Resend. Leave blank to disable.
RESEND_API_KEY=
REMINDER_FROM_EMAIL=FRADY OS <reminders@yourdomain.com>
