# --- Supabase (required) -----------------------------------------------------
# Project URL and publishable key from Supabase Dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Secret (service role) key. Server-only. Used by the scheduled sync and reminder jobs.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# --- App ---------------------------------------------------------------------
# Public origin used in auth emails (magic links / confirmations). Optional locally.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Monday.com (optional; leave blank to keep the integration disconnected) --
# Personal API token from monday.com → Profile → Developers → My access tokens. Server-only.
MONDAY_API_TOKEN=

# --- Scheduled jobs ----------------------------------------------------------
# Vercel sets Authorization: Bearer $CRON_SECRET on cron requests. Any long random string.
CRON_SECRET=change-me-to-a-long-random-string

# --- Email reminders (optional) ----------------------------------------------
# When set, the reminders job can email digests via Resend. Leave blank to disable.
RESEND_API_KEY=
REMINDER_FROM_EMAIL=FRADY OS <reminders@yourdomain.com>
